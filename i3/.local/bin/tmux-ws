#!/bin/sh
# tmux-ws — open/attach a tmux session named after the focused i3 workspace.
#
#   6:mar   -> session "mar",   ~/project/marirally_project when it exists
#   7:mar2  -> session "mar2",  ~/project/marirally
#   1:oc    -> session "oc",    $HOME
#
# The session is created on first use and attached afterwards (`tmux new -A`),
# so the same key in the same workspace always lands you back in that session.
set -eu

ws=$(i3-msg -t get_workspaces 2>/dev/null |
    jq -r '.[] | select(.focused) | .name' 2>/dev/null |
    head -n1)

# strip the "<number>:" prefix; fall back to "main"
name=${ws#*:}
[ -n "$name" ] || name=main

# slugs used by the ai helper and the workspace labels
case "$name" in
    mar) dir="$HOME/project/marirally_project" ;;
    mar2) dir="$HOME/project/marirally" ;;
    *) dir="$HOME/project/$name" ;;
esac
[ -d "$dir" ] || dir="$HOME"

# With a command argument, open a new window in the workspace session and
# attach it (used by Mod4+Shift+Return for the AI agent).
if [ "$#" -gt 0 ]; then
    if tmux has-session -t "$name" 2>/dev/null; then
        tmux new-window -t "$name" -n ai -c "$dir" "$@"
        exec tmux attach -t "$name"
    fi
    exec tmux new-session -s "$name" -n ai -c "$dir" "$@"
fi

exec tmux new -A -s "$name" -c "$dir"

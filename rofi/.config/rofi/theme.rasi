/* rofi look — Catppuccin Mocha.
 * Window chrome (mauve border) stays consistent with the i3 theme; spacing and
 * the selection colour follow the launcher reference. */
* {
    bg:       #1e1e2e;
    bg-alt:   #181825;
    bg-input: #262636;
    fg:       #cdd6f4;
    subtext:  #7f849c;
    accent:   #cba6f7;
    sel:      #89b4fa;
    base:     #1e1e2e;
    font: "JetBrainsMono Nerd Font 11";

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 520px;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-input;
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 10px;
}

/* the search hint lives in the entry placeholder, so the mode name is hidden */
prompt {
    enabled: false;
    text-color: @subtext;
}

entry {
    placeholder: " 󰍉  Search…";
    placeholder-color: @subtext;
    text-color: @fg;
}

listview {
    lines: 9;
    spacing: 2px;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 10px;
}

element-icon {
    size: 1.4em;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element selected {
    background-color: @sel;
    text-color: @base;
}

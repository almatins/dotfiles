/* rofi configuration — Catppuccin Mocha (Hyprland-like) */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    font: "JetBrainsMono Nerd Font 11";
    terminal: "ghostty";

    drun-display-format: "{name}";
    display-drun: "Aplikasi";
    display-run: "Perintah";
    display-window: "Jendela";

    drun-sort: true;
    sorting-method: "fzf";
}

/* Visual style lives in theme.rasi: border, radii, paddings, selection. */
@theme "theme"

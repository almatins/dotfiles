#######################################################################
# automatically start i3-config-wizard to offer the user to create a
# keysym-based config which used their favorite modifier (alt or windows)
#
# i3-config-wizard will not launch if there already is a config file
# in ~/.config/i3/config (or $XDG_CONFIG_HOME/i3/config if set) or
# ~/.i3/config.
#
# Please remove the following exec line:
#######################################################################

#######################################################################
# Local additions (2026-11-16)
#
# The stock Fedora config uses Alt (Mod4) as the modifier key. To switch
# the whole desktop to Super (Windows key), replace every Mod4 with Mod4:
#   sed -i 's/Mod4/Mod4/g' ~/.config/i3/config && i3-msg restart
#######################################################################

# file manager and archive manager
bindsym Mod4+Shift+f exec --no-startup-id thunar
bindsym Mod4+Shift+b exec --no-startup-id xarchiver

# help: open this keymap
bindsym Mod4+Shift+h exec --no-startup-id alacritty -e less ~/i3-keymaps.md

# screenshots: Print = interactive, Mod4+Print = silent region capture
bindsym Print exec --no-startup-id flameshot gui
bindsym Mod4+Print exec --no-startup-id maim -s ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png

# clipboard history (Mod4+v is "split vertical" in the stock config)
bindsym Mod4+Shift+v exec --no-startup-id xfce4-popup-clipman

# notifications
bindsym Mod4+grave exec --no-startup-id dunstctl close
bindsym Mod4+Shift+grave exec --no-startup-id dunstctl close-all
bindsym Mod4+Shift+p exec --no-startup-id dunstctl set-paused toggle

# --- system: lock, sleep, power -----------------------------------------
# Mod4+Shift+e (logout) already exists in the stock config above.
bindsym Mod4+Escape exec --no-startup-id ~/.config/i3/lock.sh
# Power menu (rofi): lock, lock + screen off, sleep, logout, reboot, shutdown.
# Logout/reboot/shutdown ask for confirmation inside the menu.
bindsym Mod4+Shift+d exec --no-startup-id ~/.local/bin/power-menu.sh
bindsym Mod4+Shift+s exec --no-startup-id systemctl suspend

